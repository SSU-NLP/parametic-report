VESSL_NS="seonghyeon/parametic"
VESSL_PUSH_EXCLUDES="platform_artifacts platform_scratch data_preprocess/dataset reports logs.json"
# Match the DooD-validated runner stack (Dockerfile.runner): torch 2.12 base.
# The team default (config.sh) pins torch 2.3.0, which is too old for the
# unpinned latest deepspeed/transformers in requirements-runner.txt.
VESSL_IMAGE="pytorch/pytorch:2.12.0-cuda13.0-cudnn9-devel"
